+using System;
+using System.Drawing;
+using System.Diagnostics;
+using System.IO;
+using System.Threading;
+using System.Windows.Forms;
+using System.Runtime.InteropServices;
+class ApprovalNotice : Form {
+ [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
+ [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
+ readonly string nonce;
+ readonly Label label=new Label();
+ readonly Button dismiss=new Button();
+ readonly Stopwatch clock=new Stopwatch();
+ readonly Stopwatch heartbeat=Stopwatch.StartNew();
+ readonly System.Windows.Forms.Timer timer=new System.Windows.Forms.Timer();
+ readonly StreamWriter output=new StreamWriter(Console.OpenStandardOutput());
+ readonly IntPtr initialForeground=GetForegroundWindow();
+ readonly string proof=Environment.GetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR");
+ bool savedWarning=false,savedReady=false;
+ long sequence=0,acked=0; bool release=false,invalid=false,painted=false,uncertain=false;
+ readonly object sync=new object();
+ protected override bool ShowWithoutActivation {get{return true;}}
+ protected override CreateParams CreateParams {get{var p=base.CreateParams;p.ExStyle|=0x08000000|0x00000080;return p;}}
+ public ApprovalNotice(string id) {
+  nonce=id;output.AutoFlush=true;Text="Agrippa Windows Approval Notice";TopMost=true;ShowInTaskbar=false;FormBorderStyle=FormBorderStyle.None;
+  var area=Screen.PrimaryScreen.WorkingArea;Width=Math.Min(1000,area.Width-40);Height=160;
+  StartPosition=FormStartPosition.Manual;Location=new Point(area.Left+(area.Width-Width)/2,area.Bottom-Height-20);
+  BackColor=Color.FromArgb(15,80,190);label.ForeColor=Color.White;label.Font=new Font("Segoe UI",24,FontStyle.Bold);label.Dock=DockStyle.Fill;label.TextAlign=ContentAlignment.MiddleCenter;
+  label.Text="WINDOWS APPROVAL CARD IN 1.5 SECONDS";Controls.Add(label);
+  dismiss.Text="I CLOSED THE APPROVAL CARD - DISMISS UNKNOWN NOTICE";
+  dismiss.Dock=DockStyle.Bottom;dismiss.Height=42;dismiss.Visible=false;dismiss.TabStop=false;
+  dismiss.Click+=delegate {if(uncertain&&!release)Close();};
+  Controls.Add(dismiss);
+  FormClosing+=delegate(object sender,FormClosingEventArgs e){
+   if(e.CloseReason==CloseReason.UserClosing&&!release&&!uncertain)e.Cancel=true;
+  };
+  label.Paint+=delegate {if(!painted){painted=true;clock.Start();}};
+  var input=new Thread(ReadCommands);input.IsBackground=true;input.Start();
+  timer.Interval=50;timer.Tick+=delegate{TickUI();};timer.Start();
+ }
+ void ReadCommands(){try{string line;while((line=Console.In.ReadLine())!=null){var p=line.Split(' ');lock(sync){
+  if(p.Length==3&&p[0]=="PING"&&p[1]==nonce){long n;if(!Int64.TryParse(p[2],out n)||n<=sequence){invalid=true;return;}sequence=n;heartbeat.Restart();}
+  else if(p.Length==2&&p[0]=="RELEASE"&&p[1]==nonce){release=true;return;}
+  else{invalid=true;return;}
+ }}lock(sync){invalid=true;}}catch{lock(sync){invalid=true;}}}
+ void TickUI(){lock(sync){
+  if(release){Hide();if(!IsWindowVisible(Handle)){try{output.WriteLine("HIDDEN "+nonce);}catch{}Close();}return;}
+  if(invalid||heartbeat.ElapsedMilliseconds>2000){uncertain=true;BackColor=Color.FromArgb(145,88,0);label.Text="APPROVAL STATUS UNKNOWN\nCLOSE THE APPROVAL CARD BEFORE DISMISSING";dismiss.Visible=true;Invalidate(true);Update();return;}
+  if(uncertain)return;
+  label.Text=clock.ElapsedMilliseconds<1500?"WINDOWS APPROVAL CARD IN "+(Math.Max(0,1500-clock.ElapsedMilliseconds)/1000.0).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)+" SECONDS\nPLEASE WATCH FOR YOUR APPROVAL CARD":"WINDOWS APPROVAL REQUEST\nPLEASE REVIEW THE HOST APPROVAL CARD";
+  Invalidate(true);Update();label.Update();
+  if(proof!=null&&painted&&Visible){bool ready=clock.ElapsedMilliseconds>=1500;if((ready&&!savedReady)||(!ready&&!savedWarning)){Directory.CreateDirectory(proof);using(var b=new Bitmap(Width,Height)){DrawToBitmap(b,new Rectangle(0,0,Width,Height));b.Save(Path.Combine(proof,ready?"blue-ready.png":"blue-warning.png"));}File.WriteAllText(Path.Combine(proof,"foreground.txt"),(initialForeground==GetForegroundWindow()).ToString());if(ready)savedReady=true;else savedWarning=true;}}
+  if(painted&&Visible&&IsWindowVisible(Handle)&&sequence>acked){acked=sequence;try{output.WriteLine("ACK "+nonce+" "+acked+" "+clock.ElapsedMilliseconds);}catch{invalid=true;}}
+ }}
+ [STAThread] static void Main(string[] args){Guid parsed;if(args.Length!=1||!Guid.TryParse(args[0],out parsed))return;
+  bool owned;using(var mutex=new Mutex(true,"Local\\AgrippaApprovalNoticeV3",out owned)){if(!owned)return;Application.EnableVisualStyles();Application.Run(new ApprovalNotice(args[0]));}}
+}
