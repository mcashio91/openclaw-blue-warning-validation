+using System.IO;
+using Xunit;
+namespace OpenClaw.Tray.Tests.Services;
+public sealed class ApprovalNoticePresentationContractTests
+{
+    private static string Read(string folder, string file) => File.ReadAllText(Path.Combine(
+        TestRepositoryPaths.GetRepositoryRoot(), "src", "OpenClaw.Tray.WinUI", folder, file));
+    [Fact] public void CardCannotActivateForegroundBeforeUserChoosesIt()
+    {
+        var code = Read("Dialogs", "ExecApprovalDialog.cs");
+        Assert.Contains("AppWindow.Show(false)", code);
+        Assert.DoesNotContain("SetForegroundWindow(", code);
+        Assert.DoesNotContain("SetWindowPos(", code);
+        Assert.DoesNotContain("CenterOnScreen()", code);
+        Assert.DoesNotContain("Activate()", code);
+        Assert.Contains("AppWindow.Move(", code);
+    }
+    [Fact] public void DecisionGuardStartsAfterFirstRenderAndPreservesThreeSeconds()
+    {
+        var code = Read("Dialogs", "ExecApprovalDialog.cs");
+        Assert.Contains("TimeSpan.FromSeconds(3)", code);
+        Assert.Contains("CompositionTarget.Rendering += OnFirstRendering", code);
+        Assert.Contains("CompositionTarget.Rendering -= OnFirstRendering", code);
+        var show = code.Substring(code.IndexOf("public Task<ExecApprovalPromptOutcome> ShowAsync()"));
+        Assert.True(show.IndexOf("AppWindow.Show(false)") < show.IndexOf("_showRequested = true;"));
+        var firstRender = show.Substring(show.IndexOf("private void OnFirstRendering"));
+        Assert.True(firstRender.IndexOf("_showRequested") < firstRender.IndexOf("ArmAllowGuard();"));
+        Assert.DoesNotContain("ArmAllowGuard();", code.Substring(0, code.IndexOf("private void OnFirstRendering")));
+        Assert.Equal(3, System.Text.RegularExpressions.Regex.Matches(code, "IsEnabled = false").Count);
+        Assert.Contains("if (IsClosed || !_delayElapsed) return;", code);
+        Assert.Contains("outcome != ExecApprovalPromptOutcome.Deny && !_commandFullySeen", code);
+        Assert.Contains("if (!_delayElapsed || _commandFullySeen || _bodyScroll is null) return;", code);
+    }
+    [Fact] public void PreNoticeAcquiresBeforeCardConstructionAndUsesRealClosedEvent()
+    {
+        var code = Read("Services", "ExecApprovalV2DialogPromptHandler.cs");
+        Assert.True(code.IndexOf("await ApprovalNoticeLease.AcquireAsync") < code.IndexOf("new ExecApprovalDialog(view)"));
+        Assert.Contains("_dialog.Closed +=", code);
+        Assert.Contains("ApprovalNoticeFlow.RunAsync", code);
+        var lease = Read("Services", "ApprovalNoticeLease.cs");
+        Assert.Contains("approval-v3", lease);
+        Assert.DoesNotContain("reservation.lock", lease);
+        Assert.Contains("start.ArgumentList.Add(helper)", lease);
+    }
+}
diff --git a/tests/OpenClaw.Tray.UITests/ApprovalNoticeNativeProofTests.cs b/tests/OpenClaw.Tray.UITests/ApprovalNoticeNativeProofTests.cs
new file mode 100644
index 0000000..d86b9c2
--- /dev/null
+++ b/tests/OpenClaw.Tray.UITests/ApprovalNoticeNativeProofTests.cs
@@ -0,0 +1,355 @@
+// Isolated, opt-in proof. No node request, Allow/Deny invocation, or command execution.
+using System.Diagnostics;
+using System.Drawing;
+using System.Drawing.Imaging;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using System.Windows.Automation;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.UI.Xaml.Media;
+using OpenClaw.Shared.ExecApprovals;
+using OpenClawTray.Dialogs;
+using OpenClawTray.Services;
+using WinRT.Interop;
+
+namespace OpenClaw.Tray.UITests;
+
+public sealed class NativeApprovalProofFactAttribute : FactAttribute
+{
+    public NativeApprovalProofFactAttribute()
+    {
+        if (Environment.GetEnvironmentVariable("AGRIPPA_NATIVE_APPROVAL_PROOF") != "I_AM_RUNNING_ISOLATED_PROOF")
+            Skip = "Attended isolated native approval proof is not enabled.";
+    }
+}
+
+[CollectionDefinition(Name, DisableParallelization = true)]
+public sealed class NativeApprovalProofCollection : ICollectionFixture<UIThreadFixture>
+{
+    public const string Name = "Isolated native approval proof";
+}
+
+[Collection(NativeApprovalProofCollection.Name)]
+public sealed class ApprovalNoticeNativeProofTests
+{
+    private readonly UIThreadFixture _ui;
+    public ApprovalNoticeNativeProofTests(UIThreadFixture ui) => _ui = ui;
+
+    [NativeApprovalProofFact]
+    [Trait("Category", "ManualNativeApprovalProof")]
+    public async Task BlueThenRealCard_PreservesForeground_GuardsDecisions_ClosesOnCancellation()
+    {
+        var context = RequireOptIn("card");
+        var events = new List<object>();
+        var samples = new List<object>();
+        var clock = Stopwatch.StartNew();
+        var baseline = RequireExternalVisibleForeground();
+        var oldReceipts = ReceiptFiles(context.Helper);
+        var previousProof = Environment.GetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR");
+        Environment.SetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR", context.Run);
+        using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(40));
+        ApprovalNoticeLease? lease = null;
+        Task<ExecApprovalPromptOutcome>? flow = null;
+        RealWindow? window = null;
+        var created = new TaskCompletionSource<RealWindow>(TaskCreationOptions.RunContinuationsAsynchronously);
+        var success = false;
+        try
+        {
+            var acquisition = ApprovalNoticeLease.AcquireAsync(context.Node, context.Helper, cancellation.Token);
+            try
+            {
+                var blue = await FindBlueAsync();
+                events.Add(new { name = "blue_visible", elapsedMs = clock.Elapsed.TotalMilliseconds });
+                CaptureScreen(blue, Path.Combine(context.Run, "blue-screen-visible.png"));
+                Assert.Equal(baseline, GetForegroundWindow());
+            }
+            finally
+            {
+                // Retain ownership even if a screen assertion fails during acquisition.
+                lease = await acquisition;
+            }
+            events.Add(new { name = "blue_ready", elapsedMs = clock.Elapsed.TotalMilliseconds });
+            Assert.Equal(baseline, GetForegroundWindow());
+            Assert.True(File.Exists(Path.Combine(context.Run, "blue-warning.png")));
+            Assert.True(File.Exists(Path.Combine(context.Run, "blue-ready.png")));
+            var command = string.Join(" ", Enumerable.Repeat("SYNTHETIC-REVIEW-TEXT-NOT-A-COMMAND", 250));
+            var view = new ExecApprovalPromptView(command, "NATIVE PROOF ONLY", null, null, false, true);
+            flow = ApprovalNoticeFlow.RunAsync<ExecApprovalPromptOutcome>(lease,
+                action => _ui.Dispatcher.TryEnqueue(() => action()),
+                () =>
+                {
+                    var result = new RealWindow(new ExecApprovalDialog(view));
+                    created.TrySetResult(result);
+                    return result;
+                }, cancellation.Token);
+            window = await created.Task.WaitAsync(TimeSpan.FromSeconds(8));
+            var shown = await window.Shown.Task.WaitAsync(TimeSpan.FromSeconds(8));
+            var frameTick = await window.VisibleRender.Task.WaitAsync(TimeSpan.FromSeconds(8));
+            var root = AutomationElement.FromHandle(window.Handle);
+            var deny = FindAction(root, "ExecApprovalDenyAction");
+            var once = FindAction(root, "ExecApprovalAllowOnceAction");
+            var always = FindAction(root, "ExecApprovalAllowAlwaysAction");
+            var firstSampleMs = Stopwatch.GetElapsedTime(shown.AfterTick).TotalMilliseconds;
+            Assert.InRange(firstSampleMs, 0, 750); // No vacuous guard pass after a slow UIA lookup.
+            Assert.False(deny.Current.IsEnabled);
+            Assert.False(once.Current.IsEnabled);
+            Assert.False(always.Current.IsEnabled);
+            Assert.Equal(baseline, GetForegroundWindow());
+            CaptureScreen(root, Path.Combine(context.Run, "card-first-observed-screen.png"));
+            events.Add(new { name = "visible_render", shown.BeforeTick, shown.AfterTick, frameTick,
+                firstSampleMs, frequency = Stopwatch.Frequency,
+                note = "Rendering is a pre-presentation callback, not a physical scanout timestamp." });
+
+            // Record the interval containing the first observed enable transition.
+            // Native Show returned while visible; its timestamp is a lower bound
+            // for the later first rendered frame. No 2.95-second shortcut is used.
+            double lastDisabledMs = 0;
+            double firstEnabledMs;
+            var sampleTimer = Stopwatch.StartNew();
+            while (true)
+            {
+                var tick = Stopwatch.GetTimestamp();
+                var elapsedMs = Stopwatch.GetElapsedTime(shown.AfterTick, tick).TotalMilliseconds;
+                var renderElapsedMs = Stopwatch.GetElapsedTime(frameTick, tick).TotalMilliseconds;
+                var enabled = deny.Current.IsEnabled;
+                var onceEnabled = once.Current.IsEnabled;
+                var alwaysEnabled = always.Current.IsEnabled;
+                var foreground = GetForegroundWindow();
+                samples.Add(new { tick, elapsedMs, renderElapsedMs, denyEnabled = enabled,
+                    onceEnabled, alwaysEnabled, foreground = foreground.ToInt64() });
+                Assert.Equal(baseline, foreground);
+                Assert.False(onceEnabled);
+                Assert.False(alwaysEnabled);
+                if (enabled)
+                {
+                    firstEnabledMs = elapsedMs;
+                    Assert.True(elapsedMs >= 3000, $"Deny enabled {elapsedMs:F2} ms after visible Show returned.");
+                    // The test callback runs just after production's callback in
+                    // the same Rendering event; record that small observer skew.
+                    Assert.True(renderElapsedMs >= 2990, $"Deny enabled {renderElapsedMs:F2} ms after observed render.");
+                    break;
+                }
+                lastDisabledMs = elapsedMs;
+                Assert.True(sampleTimer.Elapsed < TimeSpan.FromSeconds(6), "Deny never armed.");
+                await Task.Delay(20);
+            }
+            Assert.True(firstEnabledMs - lastDisabledMs < 250, "Guard transition observation gap exceeded 250 ms.");
+            events.Add(new { name = "deny_enable_transition", lastDisabledMs, firstEnabledMs });
+            CaptureScreen(root, Path.Combine(context.Run, "deny-armed-allow-disabled.png"));
+            await _ui.RunOnUIAsync(() =>
+            {
+                var scroll = TestSupport.FindLogical<ScrollViewer>(window.Dialog.Content).Single();
+                Assert.True(scroll.ScrollableHeight > 0);
+                Assert.True(scroll.ChangeView(null, scroll.ScrollableHeight, null, disableAnimation: true));
+            });
+            await WaitUntilAsync(() => once.Current.IsEnabled && always.Current.IsEnabled, TimeSpan.FromSeconds(3));
+            Assert.Equal(baseline, GetForegroundWindow());
+            CaptureScreen(root, Path.Combine(context.Run, "scroll-end-actions-enabled.png"));
+            events.Add(new { name = "scroll_end_actions_enabled", elapsedMs = clock.Elapsed.TotalMilliseconds });
+            cancellation.Cancel();
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => flow);
+            await window.Closed.WaitAsync(TimeSpan.FromSeconds(3));
+            Assert.False(IsWindowVisible(window.Handle));
+            Assert.Equal(baseline, GetForegroundWindow());
+            CopyReleasedReceipt(context, oldReceipts);
+            Assert.Null(FindBlue());
+            events.Add(new { name = "cancel_closed_and_released", elapsedMs = clock.Elapsed.TotalMilliseconds });
+            success = true;
+        }
+        finally
+        {
+            cancellation.Cancel();
+            try
+            {
+                if (flow is not null)
+                {
+                    try { await flow.WaitAsync(TimeSpan.FromSeconds(12)); }
+                    catch (OperationCanceledException) { }
+                }
+                else if (lease is not null)
+                    await lease.ReleaseAsync(); // No card was ever handed to the flow.
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR", previousProof);
+                await File.WriteAllTextAsync(Path.Combine(context.Run, "events.json"),
+                    JsonSerializer.Serialize(new { success, events, samples }, new JsonSerializerOptions { WriteIndented = true }));
+            }
+        }
+    }
+
+    [NativeApprovalProofFact]
+    [Trait("Category", "ManualNativeApprovalProof")]
+    public async Task CancelBlueAcquisitionBeforeReady_ReleasesWithoutCreatingCard()
+    {
+        var context = RequireOptIn("countdown-cancel");
+        var baseline = RequireExternalVisibleForeground();
+        var oldReceipts = ReceiptFiles(context.Helper);
+        var previousProof = Environment.GetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR");
+        Environment.SetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR", context.Run);
+        using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(15));
+        var acquisition = ApprovalNoticeLease.AcquireAsync(context.Node, context.Helper, cancellation.Token);
+        var success = false;
+        long cancelTick = 0;
+        try
+        {
+            var blue = await FindBlueAsync();
+            Assert.False(acquisition.IsCompleted, "READY arrived before countdown cancellation could be observed.");
+            var blueHandle = new IntPtr(blue.Current.NativeWindowHandle);
+            cancelTick = Stopwatch.GetTimestamp();
+            cancellation.Cancel(); // No Flow or card exists in this acquisition-only scenario.
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => acquisition);
+            Assert.False(IsWindowVisible(blueHandle));
+            Assert.Equal(baseline, GetForegroundWindow());
+            CopyReleasedReceipt(context, oldReceipts);
+            Assert.Null(FindBlue());
+            success = true;
+        }
+        finally
+        {
+            cancellation.Cancel();
+            try
+            {
+                try { var acquired = await acquisition; await acquired.ReleaseAsync(); }
+                catch (OperationCanceledException) { }
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable("AGRIPPA_NOTICE_PROOF_DIR", previousProof);
+                await File.WriteAllTextAsync(Path.Combine(context.Run, "result.json"),
+                    JsonSerializer.Serialize(new { success, cancelTick, scenario = "acquisition-only; no card constructed" }));
+            }
+        }
+    }
+
+    private sealed record ProofContext(string Node, string Helper, string Run);
+    private static ProofContext RequireOptIn(string scenario)
+    {
+        Assert.Equal("I_AM_RUNNING_ISOLATED_PROOF", Environment.GetEnvironmentVariable("AGRIPPA_NATIVE_APPROVAL_PROOF"));
+        Assert.True(Environment.UserInteractive, "An attended interactive Windows session is required.");
+        var node = Environment.GetEnvironmentVariable("AGRIPPA_PROOF_NODE_EXE") ?? "";
+        var helper = Environment.GetEnvironmentVariable("AGRIPPA_PROOF_HELPER_MJS") ?? "";
+        var root = Environment.GetEnvironmentVariable("AGRIPPA_NATIVE_PROOF_DIR") ?? "";
+        var data = Environment.GetEnvironmentVariable("OPENCLAW_TRAY_DATA_DIR") ?? "";
+        Assert.True(File.Exists(node) && File.Exists(helper) && Directory.Exists(root) && Directory.Exists(data));
+        Assert.True(File.Exists(Path.Combine(Path.GetDirectoryName(helper)!, "ApprovalNotice.exe")));
+        var production = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Agrippa");
+        Assert.False(Path.GetFullPath(helper).StartsWith(production + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase));
+        var noticeExists = Mutex.TryOpenExisting(@"Local\AgrippaApprovalNoticeV3", out var noticeMutex);
+        noticeMutex?.Dispose();
+        Assert.False(noticeExists, "Another notice owns this interactive session.");
+        Assert.Null(FindBlue());
+        var run = Path.Combine(root, scenario + "-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(run);
+        return new(node, helper, run);
+    }
+
+    private static IntPtr RequireExternalVisibleForeground()
+    {
+        var foreground = GetForegroundWindow();
+        Assert.NotEqual(IntPtr.Zero, foreground);
+        Assert.True(IsWindowVisible(foreground));
+        GetWindowThreadProcessId(foreground, out var processId);
+        Assert.NotEqual((uint)Environment.ProcessId, processId);
+        return foreground;
+    }
+
+    private static HashSet<string> ReceiptFiles(string helper)
+    {
+        var dir = Path.Combine(Path.GetDirectoryName(helper)!, "receipts");
+        return Directory.Exists(dir) ? Directory.GetFiles(dir, "*.json").ToHashSet(StringComparer.OrdinalIgnoreCase) : new(StringComparer.OrdinalIgnoreCase);
+    }
+
+    private static void CopyReleasedReceipt(ProofContext context, HashSet<string> old)
+    {
+        var path = Assert.Single(ReceiptFiles(context.Helper).Except(old));
+        using var receipt = JsonDocument.Parse(File.ReadAllBytes(path));
+        Assert.Equal(1, receipt.RootElement.GetProperty("schema").GetInt32());
+        Assert.Equal("released", receipt.RootElement.GetProperty("outcome").GetString());
+        Assert.Equal(Path.GetFileNameWithoutExtension(path), receipt.RootElement.GetProperty("nonce").GetString());
+        Assert.Contains(receipt.RootElement.GetProperty("events").EnumerateArray(),
+            entry => entry.GetProperty("name").GetString() == "hidden_confirmed");
+        File.Copy(path, Path.Combine(context.Run, "released-receipt.json"), overwrite: false);
+    }
+
+    private static AutomationElement? FindBlue() => AutomationElement.RootElement.FindFirst(TreeScope.Children,
+        new PropertyCondition(AutomationElement.NameProperty, "Agrippa Windows Approval Notice"));
+
+    private static async Task<AutomationElement> FindBlueAsync()
+    {
+        AutomationElement? blue = null;
+        await WaitUntilAsync(() => { blue = FindBlue(); return blue is not null && IsWindowVisible(new IntPtr(blue.Current.NativeWindowHandle)); }, TimeSpan.FromSeconds(5));
+        return blue!;
+    }
+
+    private static AutomationElement FindAction(AutomationElement root, string id) =>
+        root.FindFirst(TreeScope.Descendants, new PropertyCondition(AutomationElement.AutomationIdProperty, id))
+        ?? throw new InvalidOperationException($"Native action {id} is missing.");
+
+    private static async Task WaitUntilAsync(Func<bool> predicate, TimeSpan timeout)
+    {
+        var clock = Stopwatch.StartNew();
+        while (clock.Elapsed < timeout)
+        {
+            try { if (predicate()) return; }
+            catch (ElementNotAvailableException) { }
+            await Task.Delay(20);
+        }
+        throw new TimeoutException("Native proof observation timed out.");
+    }
+
+    private static void CaptureScreen(AutomationElement element, string path)
+    {
+        var bounds = element.Current.BoundingRectangle;
+        var width = (int)Math.Ceiling(bounds.Width);
+        var height = (int)Math.Ceiling(bounds.Height);
+        Assert.True(width >= 300 && height >= 80, "Visible native window bounds are missing.");
+        using var bitmap = new Bitmap(width, height, PixelFormat.Format32bppArgb);
+        using (var graphics = Graphics.FromImage(bitmap))
+            graphics.CopyFromScreen((int)Math.Floor(bounds.Left), (int)Math.Floor(bounds.Top), 0, 0, new Size(width, height), CopyPixelOperation.SourceCopy);
+        var colors = new HashSet<int>();
+        for (var y = 0; y < height; y += Math.Max(1, height / 32))
+            for (var x = 0; x < width; x += Math.Max(1, width / 32)) colors.Add(bitmap.GetPixel(x, y).ToArgb());
+        Assert.True(colors.Count >= 3, "Screen capture is blank or near-uniform.");
+        bitmap.Save(path, ImageFormat.Png);
+        Assert.True(new FileInfo(path).Length > 1000);
+    }
+
+    [DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
+    [DllImport("user32.dll")] private static extern uint GetWindowThreadProcessId(IntPtr hwnd, out uint processId);
+    [DllImport("user32.dll")] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool IsWindowVisible(IntPtr hwnd);
+
+    private sealed class RealWindow : IApprovalNoticeWindow<ExecApprovalPromptOutcome>
+    {
+        public ExecApprovalDialog Dialog { get; }
+        public IntPtr Handle { get; }
+        private readonly TaskCompletionSource<bool> _closed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public Task Closed => _closed.Task;
+        public TaskCompletionSource<(long BeforeTick, long AfterTick)> Shown { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public TaskCompletionSource<long> VisibleRender { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public RealWindow(ExecApprovalDialog dialog)
+        {
+            Dialog = dialog;
+            Handle = WindowNative.GetWindowHandle(dialog);
+            ((FrameworkElement)dialog.Content).Loaded += (_, _) => CompositionTarget.Rendering += OnRendering;
+            dialog.Closed += (_, _) => { CompositionTarget.Rendering -= OnRendering; _closed.TrySetResult(true); };
+        }
+        private void OnRendering(object? sender, object args)
+        {
+            var content = (FrameworkElement)Dialog.Content;
+            if (!Shown.Task.IsCompleted || Dialog.IsClosed || !content.IsLoaded || content.ActualWidth <= 0 || !IsWindowVisible(Handle)) return;
+            CompositionTarget.Rendering -= OnRendering;
+            VisibleRender.TrySetResult(Stopwatch.GetTimestamp());
+        }
+        public Task<ExecApprovalPromptOutcome> ShowAsync()
+        {
+            var before = Stopwatch.GetTimestamp();
+            var result = Dialog.ShowAsync();
+            Assert.True(IsWindowVisible(Handle));
+            Shown.TrySetResult((before, Stopwatch.GetTimestamp()));
+            return result;
+        }
+        public void Close() { if (!Dialog.IsClosed) Dialog.Close(); }
+    }
+}
