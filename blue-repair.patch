+import {mkdir,writeFile,readFile} from 'node:fs/promises';
+import {performance} from 'node:perf_hooks';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import assert from 'node:assert/strict';
+const root=path.dirname(fileURLToPath(import.meta.url)),dir=path.join(root,'proof-'+randomUUID());await mkdir(dir);
+const started=performance.now();const child=spawn(path.join(root,'ApprovalNotice.exe'),[randomUUID()],{windowsHide:true,stdio:['pipe','pipe','pipe'],env:{...process.env,AGRIPPA_NOTICE_PROOF_DIR:dir}});
+const nonce=child.spawnargs[1];let seq=0,readyAt=null,hidden=false;const rows=[];
+const timer=setInterval(()=>child.stdin.write(`PING ${nonce} ${++seq}\n`),200);
+const deadline=setTimeout(()=>{clearInterval(timer);child.stdin.write(`RELEASE ${nonce}\n`);process.exitCode=1;setTimeout(async()=>{await writeFile(path.join(dir,'receipt-timeout.json'),JSON.stringify({outcome:'unknown',rows}));process.exit(2);},3000).unref();},10000);
+child.stderr.resume();child.stdin.on('error',()=>{});
+createInterface({input:child.stdout}).on('line',line=>{rows.push({line,elapsed:performance.now()-started});const p=line.split(' ');
+ if(p[0]==='ACK'&&Number(p[3])>=1500&&readyAt===null){readyAt=performance.now()-started;clearInterval(timer);child.stdin.write(`RELEASE ${nonce}\n`);}
+ if(line===`HIDDEN ${nonce}`)hidden=true;
+});
+await new Promise((resolve,reject)=>{child.on('error',reject);child.on('exit',resolve);});clearTimeout(deadline);clearInterval(timer);
+await writeFile(path.join(dir,'receipt.json'),JSON.stringify({readyAt,hidden,rows},null,2));assert(readyAt>=1500);assert(hidden);assert.equal((await readFile(path.join(dir,'foreground.txt'),'utf8')).trim(),'True');
+console.log('PASS rendered >=1.5s, hidden acknowledged, foreground unchanged. Inspect PNGs in '+dir);
