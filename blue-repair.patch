@@ -0,0 +1,85 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using OpenClawTray.Services;
+using Xunit;
+
+namespace OpenClaw.Tray.Tests.Services;
+
+public sealed class ApprovalNoticeFlowTests
+{
+    [Fact]
+    public async Task DecisionDoesNotReturnOrReleaseNoticeUntilActualClosedSignal()
+    {
+        var lease = new FakeLease();
+        var window = new FakeWindow();
+        var run = ApprovalNoticeFlow.RunAsync(lease, RunInline, () => window, CancellationToken.None);
+        await window.Shown.WaitAsync(TimeSpan.FromSeconds(1));
+        window.Decide(1);
+        Assert.False(run.IsCompleted);
+        Assert.Equal(0, lease.ReleaseCount);
+        window.SignalClosed();
+        Assert.Equal(1, await run.WaitAsync(TimeSpan.FromSeconds(1)));
+        Assert.Equal(1, lease.ReleaseCount);
+        Assert.Equal(0, lease.AbandonCount);
+    }
+
+    [Fact]
+    public async Task LostNoticeWithUnconfirmedWindowNeverReleasesAsSuccess()
+    {
+        var lease = new FakeLease();
+        var window = new FakeWindow();
+        var run = ApprovalNoticeFlow.RunAsync(lease, RunInline, () => window,
+            CancellationToken.None, TimeSpan.FromMilliseconds(25));
+        await window.Shown.WaitAsync(TimeSpan.FromSeconds(1));
+        lease.Lose();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run.WaitAsync(TimeSpan.FromSeconds(1)));
+        Assert.True(window.CloseCount > 0);
+        Assert.Equal(0, lease.ReleaseCount);
+        Assert.Equal(1, lease.AbandonCount);
+    }
+
+    [Fact]
+    public async Task CancellationBeforeQueuedConstructionCannotCreateCard()
+    {
+        var lease = new FakeLease();
+        using var cancellation = new CancellationTokenSource();
+        Action? queued = null;
+        var creates = 0;
+        var run = ApprovalNoticeFlow.RunAsync(lease, action => { queued = action; return true; },
+            () => { creates++; return new FakeWindow(); }, cancellation.Token);
+        cancellation.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run.WaitAsync(TimeSpan.FromSeconds(1)));
+        Assert.NotNull(queued);
+        queued!();
+        Assert.Equal(0, creates);
+        Assert.Equal(1, lease.ReleaseCount);
+    }
+
+    private static bool RunInline(Action action) { action(); return true; }
+
+    private sealed class FakeLease : IApprovalNoticeLease
+    {
+        private readonly CancellationTokenSource _lost = new();
+        public CancellationToken Lost => _lost.Token;
+        public int ReleaseCount { get; private set; }
+        public int AbandonCount { get; private set; }
+        public void Lose() => _lost.Cancel();
+        public Task ReleaseAsync() { ReleaseCount++; return Task.CompletedTask; }
+        public void Abandon() => AbandonCount++;
+    }
+
+    private sealed class FakeWindow : IApprovalNoticeWindow<int>
+    {
+        private readonly TaskCompletionSource<int> _decision = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        private readonly TaskCompletionSource<bool> _closed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        private readonly TaskCompletionSource<bool> _shown = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public Task Shown => _shown.Task;
+        public Task Closed => _closed.Task;
+        public int CloseCount { get; private set; }
+        public Task<int> ShowAsync() { _shown.TrySetResult(true); return _decision.Task; }
+        public void Decide(int value) => _decision.TrySetResult(value);
+        public void SignalClosed() => _closed.TrySetResult(true);
+        public void Close() => CloseCount++;
+    }
+}
