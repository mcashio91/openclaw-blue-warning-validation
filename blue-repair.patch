+
+const root=path.dirname(fileURLToPath(import.meta.url));
+const runs=path.join(root,'test-runs');
+await mkdir(runs,{recursive:true});
+const dir=await mkdtemp(path.join(runs,'receipt-'));
+
+let allowWrite;
+const writeGate=new Promise(resolve=>{allowWrite=resolve;});
+const calls=[];
+let mockBytes;
+const pending=persistReceiptThenAcknowledge({dir,nonce:'00000000-0000-0000-0000-000000000001',outcome:'released',events:[],
+ storage:{writeFile:async(_path,bytes)=>{await writeGate;mockBytes=bytes;},rename:async()=>{calls.push('renamed');},readFile:async()=>mockBytes},
+ acknowledge:async()=>{assert.deepEqual(calls,['renamed']);calls.push('acknowledged');}});
+await Promise.resolve();
+assert.deepEqual(calls,[],'acknowledgement preceded receipt write');
+allowWrite();
+await pending;
+assert.deepEqual(calls,['renamed','acknowledged']);
+
+let acknowledged=false;
+await assert.rejects(persistReceiptThenAcknowledge({dir,nonce:'00000000-0000-0000-0000-000000000002',outcome:'released',events:[],
+ storage:{writeFile:async()=>{throw Error('disk unavailable');},rename:async()=>{},readFile:async()=>''},
+ acknowledge:async()=>{acknowledged=true;}}),/disk unavailable/);
+assert.equal(acknowledged,false,'receipt failure acknowledged release');
+await assert.rejects(persistReceiptThenAcknowledge({dir,nonce:'00000000-0000-0000-0000-000000000002',outcome:'released',events:[],
+ storage:{writeFile:async()=>{},rename:async()=>{},readFile:async()=>''},
+ acknowledge:async()=>{acknowledged=true;}}),/readback mismatch/);
+assert.equal(acknowledged,false,'receipt mismatch acknowledged release');
+
+await persistReceiptThenAcknowledge({dir,nonce:'00000000-0000-0000-0000-000000000003',outcome:'unknown',events:[{name:'lost'}],
+ acknowledge:async()=>{throw Error('unknown was acknowledged');}});
+const unknown=JSON.parse(await readFile(path.join(dir,'00000000-0000-0000-0000-000000000003.json'),'utf8'));
+assert.equal(unknown.outcome,'unknown');
+assert.deepEqual((await readdir(dir)).sort(),['00000000-0000-0000-0000-000000000003.json']);
+console.log('PASS: durable acknowledgement order, write failure, unknown receipt');
