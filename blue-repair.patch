+using System.IO;
+using Xunit;
+namespace OpenClaw.Tray.Tests.Services;
+public sealed class ApprovalNoticePresentationContractTests
+{
+    private static string Read(string folder, string file) => File.ReadAllText(Path.Combine(
+        TestRepositoryPaths.GetRepositoryRoot(), "src", "OpenClaw.Tray.WinUI", folder, file));
+    [Fact] public void CardCannotActivateForegroundBeforeUserChoosesIt()
+    {
+        var code = Read("Dialogs", "ExecApprovalDialog.cs");
+        Assert.Contains("AppWindow.Show(false)", code);
+        Assert.DoesNotContain("SetForegroundWindow(", code);
+        Assert.DoesNotContain("SetWindowPos(", code);
+        Assert.DoesNotContain("CenterOnScreen()", code);
+        Assert.DoesNotContain("Activate()", code);
+        Assert.Contains("AppWindow.Move(", code);
+    }
+    [Fact] public void DecisionGuardStartsAtShowAndPreservesThreeSeconds()
+    {
+        var code = Read("Dialogs", "ExecApprovalDialog.cs");
+        Assert.Contains("TimeSpan.FromSeconds(3)", code);
+        var show = code.Substring(code.IndexOf("public Task<ExecApprovalPromptOutcome> ShowAsync()"));
+        Assert.True(show.IndexOf("ArmAllowGuard();") < show.IndexOf("AppWindow.Show(false)"));
+        Assert.DoesNotContain("ArmAllowGuard();", code.Substring(0, code.IndexOf("public Task<ExecApprovalPromptOutcome> ShowAsync()")));
+        Assert.Contains("if (IsClosed || !_delayElapsed) return;", code);
+        Assert.Contains("outcome != ExecApprovalPromptOutcome.Deny && !_commandFullySeen", code);
+        Assert.Contains("if (!_delayElapsed || _commandFullySeen || _bodyScroll is null) return;", code);
+    }
+    [Fact] public void PreNoticeAcquiresBeforeCardConstructionAndUsesRealClosedEvent()
+    {
+        var code = Read("Services", "ExecApprovalV2DialogPromptHandler.cs");
+        Assert.True(code.IndexOf("await ApprovalNoticeLease.AcquireAsync") < code.IndexOf("new ExecApprovalDialog(view)"));
+        Assert.Contains("_dialog.Closed +=", code);
+        Assert.Contains("ApprovalNoticeFlow.RunAsync", code);
+        var lease = Read("Services", "ApprovalNoticeLease.cs");
+        Assert.Contains("approval-v3", lease);
+        Assert.DoesNotContain("reservation.lock", lease);
+        Assert.Contains("start.ArgumentList.Add(helper)", lease);
+    }
+}
