diff --git a/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeFlow.cs b/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeFlow.cs
new file mode 100644
index 0000000..b48cebe
--- /dev/null
+++ b/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeFlow.cs
@@ -0,0 +1,104 @@
+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace OpenClawTray.Services;
+
+internal interface IApprovalNoticeWindow<T>
+{
+    Task Closed { get; }
+    Task<T> ShowAsync();
+    void Close();
+}
+
+// UI-framework-independent seam: all native window operations stay on dispatcher.
+internal static class ApprovalNoticeFlow
+{
+    internal static async Task<T> RunAsync<T>(IApprovalNoticeLease lease,
+        Func<Action, bool> enqueue, Func<IApprovalNoticeWindow<T>> create,
+        CancellationToken cancellationToken, TimeSpan? lifecycleTimeout = null)
+    {
+        var timeout = lifecycleTimeout ?? TimeSpan.FromSeconds(8);
+        using var lifetime = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, lease.Lost);
+        var token = lifetime.Token;
+        var gate = new object();
+        bool constructing = false, ending = false;
+        IApprovalNoticeWindow<T>? window = null;
+        var shown = new TaskCompletionSource<Task<T>>(TaskCreationOptions.RunContinuationsAsynchronously);
+        var closed = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+        void QueueClose()
+        {
+            // Failed enqueue never implies closure.
+            try
+            {
+                enqueue(() =>
+                {
+                    try { window?.Close(); }
+                    catch { /* Actual Closed remains the only proof. */ }
+                });
+            }
+            catch { /* Dispatcher failure is not confirmed closure. */ }
+        }
+        using var registration = token.Register(QueueClose);
+        try
+        {
+            token.ThrowIfCancellationRequested();
+            if (!enqueue(() =>
+            {
+                lock (gate)
+                {
+                    if (ending || token.IsCancellationRequested)
+                    {
+                        shown.TrySetCanceled();
+                        return;
+                    }
+                    constructing = true;
+                }
+                try
+                {
+                    window = create();
+                    _ = ObserveClosedAsync(window.Closed, closed);
+                    // Recheck after construction: canceled requests never flash.
+                    token.ThrowIfCancellationRequested();
+                    shown.TrySetResult(window.ShowAsync());
+                }
+                catch (Exception ex)
+                {
+                    try { window?.Close(); } catch { }
+                    shown.TrySetException(ex);
+                }
+            })) throw new IOException("Approval UI dispatcher unavailable.");
+            var outcome = await shown.Task.WaitAsync(timeout, token).ConfigureAwait(false);
+            var result = await outcome.WaitAsync(token).ConfigureAwait(false);
+            // Outcome tasks can fault/complete early; Closed is separate evidence.
+            await closed.Task.WaitAsync(timeout, token).ConfigureAwait(false);
+            token.ThrowIfCancellationRequested();
+            return result;
+        }
+        finally
+        {
+            lifetime.Cancel();
+            bool attempted;
+            lock (gate)
+            {
+                ending = true; // Prevents a delayed UI callback from creating a card.
+                attempted = constructing;
+            }
+            if (attempted)
+            {
+                QueueClose();
+                try { await closed.Task.WaitAsync(timeout).ConfigureAwait(false); }
+                catch { lease.Abandon(); }
+            }
+            if (!attempted || closed.Task.IsCompletedSuccessfully)
+                await lease.ReleaseAsync().ConfigureAwait(false);
+        }
+    }
+
+    private static async Task ObserveClosedAsync(Task source, TaskCompletionSource<bool> target)
+    {
+        try { await source.ConfigureAwait(false); target.TrySetResult(true); }
+        catch { /* Faulted show/close is not closure evidence. */ }
+    }
+}
diff --git a/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeLease.cs b/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeLease.cs
new file mode 100644
index 0000000..b35d6ac
--- /dev/null
+++ b/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeLease.cs
@@ -0,0 +1,139 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace OpenClawTray.Services;
+
+internal interface IApprovalNoticeLease
+{
+    CancellationToken Lost { get; }
+    Task ReleaseAsync();
+    void Abandon();
+}
+
+// No command text, credentials or decisions enter this process. One stdout reader
+// owns the entire protocol, including ongoing LOST/EOF detection after READY.
+internal sealed class ApprovalNoticeLease : IApprovalNoticeLease
+{
+    private readonly Process _process;
+    private readonly CancellationTokenSource _lost = new();
+    private readonly TaskCompletionSource<bool> _ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private readonly TaskCompletionSource<bool> _released = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private int _releaseStarted;
+    private int _disposed;
+    public CancellationToken Lost => _lost.Token;
+
+    private ApprovalNoticeLease(Process process)
+    {
+        _process = process;
+        _ = DrainErrorAsync();
+        _ = ReadProtocolAsync();
+    }
+
+    private async Task DrainErrorAsync()
+    {
+        try
+        {
+            var buffer = new char[1024];
+            while (await _process.StandardError.ReadAsync(buffer.AsMemory()).ConfigureAwait(false) != 0) { }
+        }
+        catch { /* Never retain uncontrolled helper output. */ }
+    }
+
+    private async Task ReadProtocolAsync()
+    {
+        try
+        {
+            string? line;
+            while ((line = await _process.StandardOutput.ReadLineAsync().ConfigureAwait(false)) != null)
+            {
+                if (line == "READY" && !_ready.Task.IsCompleted && !_lost.IsCancellationRequested)
+                    _ready.TrySetResult(true);
+                else if (line == "RELEASED" && Volatile.Read(ref _releaseStarted) != 0)
+                {
+                    _released.TrySetResult(true);
+                    return;
+                }
+                else if (line == "LOST")
+                    MarkLost();
+                else
+                {
+                    MarkLost();
+                    return;
+                }
+            }
+        }
+        catch { }
+        if (!_released.Task.IsCompletedSuccessfully) MarkLost();
+    }
+
+    private void MarkLost()
+    {
+        _lost.Cancel();
+        _ready.TrySetException(new IOException("Approval notice unavailable."));
+    }
+
+    internal static Task<ApprovalNoticeLease> AcquireAsync(CancellationToken token)
+    {
+        var local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        var profile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        return AcquireAsync(Path.Combine(profile, "nodejs", "node.exe"),
+            Path.Combine(local, "Agrippa", "ControlIndicator", "approval-v3", "approval-notice.mjs"), token);
+    }
+
+    internal static async Task<ApprovalNoticeLease> AcquireAsync(string executable, string helper, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        var start = new ProcessStartInfo(executable)
+        {
+            UseShellExecute = false, CreateNoWindow = true,
+            RedirectStandardInput = true, RedirectStandardOutput = true, RedirectStandardError = true
+        };
+        start.ArgumentList.Add(helper); // Paths with spaces remain a single argument.
+        var lease = new ApprovalNoticeLease(Process.Start(start) ?? throw new IOException("Approval notice did not start."));
+        try
+        {
+            using var wait = CancellationTokenSource.CreateLinkedTokenSource(token, lease.Lost);
+            wait.CancelAfter(TimeSpan.FromSeconds(12));
+            await lease._ready.Task.WaitAsync(wait.Token).ConfigureAwait(false);
+            wait.Token.ThrowIfCancellationRequested();
+            return lease;
+        }
+        catch
+        {
+            // No card constructed, so RELEASE is safe even during countdown.
+            try { await lease.ReleaseAsync().ConfigureAwait(false); }
+            catch { lease.Abandon(); }
+            throw;
+        }
+    }
+
+    // Caller must prove no window exists or its actual Closed event fired.
+    public async Task ReleaseAsync()
+    {
+        if (Interlocked.Exchange(ref _releaseStarted, 1) != 0)
+            throw new InvalidOperationException("Approval notice already releasing.");
+        using var wait = new CancellationTokenSource(TimeSpan.FromSeconds(8));
+        try
+        {
+            await _process.StandardInput.WriteLineAsync("RELEASE".AsMemory(), wait.Token).ConfigureAwait(false);
+            await _process.StandardInput.FlushAsync(wait.Token).ConfigureAwait(false);
+            await _released.Task.WaitAsync(wait.Token).ConfigureAwait(false);
+            await _process.WaitForExitAsync(wait.Token).ConfigureAwait(false);
+            if (_process.ExitCode != 0)
+                throw new IOException($"Approval notice exited with status {_process.ExitCode}.");
+        }
+        finally { Abandon(); }
+    }
+
+    // Does NOT send RELEASE or delete any locks. EOF keeps uncertain state on the
+    // helper side when actual window closure could not be established.
+    public void Abandon()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+        try { _process.StandardInput.Dispose(); } catch { }
+        _process.Dispose();
+    }
+}
