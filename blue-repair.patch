index 00000000..b48cebe9
--- /dev/null
+++ b/src/OpenClaw.Tray.WinUI/Services/ApprovalNoticeFlow.cs
@@ -0,0 +1,104 @@
+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace OpenClawTray.Services;
+
+internal interface IApprovalNoticeWindow<T>
+{
+    Task Closed { get; }
+    Task<T> ShowAsync();
+    void Close();
+}
+
+// UI-framework-independent seam: all native window operations stay on dispatcher.
+internal static class ApprovalNoticeFlow
+{
+    internal static async Task<T> RunAsync<T>(IApprovalNoticeLease lease,
+        Func<Action, bool> enqueue, Func<IApprovalNoticeWindow<T>> create,
+        CancellationToken cancellationToken, TimeSpan? lifecycleTimeout = null)
+    {
+        var timeout = lifecycleTimeout ?? TimeSpan.FromSeconds(8);
+        using var lifetime = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, lease.Lost);
+        var token = lifetime.Token;
+        var gate = new object();
+        bool constructing = false, ending = false;
+        IApprovalNoticeWindow<T>? window = null;
+        var shown = new TaskCompletionSource<Task<T>>(TaskCreationOptions.RunContinuationsAsynchronously);
+        var closed = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+        void QueueClose()
+        {
+            // Failed enqueue never implies closure.
+            try
+            {
+                enqueue(() =>
+                {
+                    try { window?.Close(); }
+                    catch { /* Actual Closed remains the only proof. */ }
+                });
+            }
+            catch { /* Dispatcher failure is not confirmed closure. */ }
+        }
+        using var registration = token.Register(QueueClose);
+        try
+        {
+            token.ThrowIfCancellationRequested();
+            if (!enqueue(() =>
+            {
+                lock (gate)
+                {
+                    if (ending || token.IsCancellationRequested)
+                    {
+                        shown.TrySetCanceled();
+                        return;
+                    }
+                    constructing = true;
+                }
+                try
+                {
+                    window = create();
+                    _ = ObserveClosedAsync(window.Closed, closed);
+                    // Recheck after construction: canceled requests never flash.
+                    token.ThrowIfCancellationRequested();
+                    shown.TrySetResult(window.ShowAsync());
+                }
+                catch (Exception ex)
+                {
+                    try { window?.Close(); } catch { }
+                    shown.TrySetException(ex);
+                }
+            })) throw new IOException("Approval UI dispatcher unavailable.");
+            var outcome = await shown.Task.WaitAsync(timeout, token).ConfigureAwait(false);
+            var result = await outcome.WaitAsync(token).ConfigureAwait(false);
+            // Outcome tasks can fault/complete early; Closed is separate evidence.
+            await closed.Task.WaitAsync(timeout, token).ConfigureAwait(false);
+            token.ThrowIfCancellationRequested();
+            return result;
+        }
+        finally
+        {
+            lifetime.Cancel();
+            bool attempted;
+            lock (gate)
+            {
+                ending = true; // Prevents a delayed UI callback from creating a card.
+                attempted = constructing;
+            }
+            if (attempted)
+            {
+                QueueClose();
+                try { await closed.Task.WaitAsync(timeout).ConfigureAwait(false); }
+                catch { lease.Abandon(); }
+            }
+            if (!attempted || closed.Task.IsCompletedSuccessfully)
+                await lease.ReleaseAsync().ConfigureAwait(false);
+        }
+    }
+
+    private static async Task ObserveClosedAsync(Task source, TaskCompletionSource<bool> target)
+    {
+        try { await source.ConfigureAwait(false); target.TrySetResult(true); }
+        catch { /* Faulted show/close is not closure evidence. */ }
+    }
+}
