+#Requires -Version 7.0
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$SourceRepository,
+    [Parameter(Mandatory)][string]$RepairPatch,
+    [Parameter(Mandatory)][string]$HelperSource,
+    [Parameter(Mandatory)][string]$Dotnet,
+    [string]$Node,
+    [switch]$AttendedSyntheticProof
+)
+$ErrorActionPreference = 'Stop'
+if (-not $IsWindows) { throw 'This launcher is Windows-only.' }
+$baseCommit = '3c43751b2bace876de3febe478ebabeca172e3ac'
+$repairDigest = 'aeb0a18b9b22209a94d8b934bda928104552a91af6b9316dbe566e0e6e69b9d4'
+$proofDigest = '2d20a60e42f5ed466cfaaafd7ff2e28698e2af1655c12931aaaab548265cc8c1'
+$helperDigests = @{
+    'ApprovalNotice.cs' = 'fa2a21f07d6fc1bcf4d2e236e78105a782e13d9684c7be68dd690af54a20303f'
+    'approval-notice.mjs' = '9c2fb510b6f330f47200fff32fe2c63bacbd8d56ede4dc44fbe623a9b91df6d7'
+    'protocol.mjs' = '0c76fa0dbaee65ee68ed272afcf451bf05172ba28ffe7d6340271a6fc5ea42bc'
+    'receipt.mjs' = '776867b560416b56b98f995e6f0c40a7dbb1784341a762027b2f54a8e2280c2f'
+    'render-proof.mjs' = 'c7a5809fb7ac8a723b0a05a8066a28328e2e75a9833e9dc2bf1e95486c948d8e'
+}
+$proofPatch = Join-Path $PSScriptRoot 'native-proof.patch'
+foreach ($item in @($RepairPatch, $proofPatch, $Dotnet)) {
+    if (-not (Test-Path -LiteralPath $item -PathType Leaf)) { throw "Missing required file: $item" }
+}
+if (-not (Test-Path -LiteralPath (Join-Path $SourceRepository '.git'))) { throw 'A local source git checkout is required; this launcher performs no network clone.' }
+if ((Get-FileHash -LiteralPath $RepairPatch -Algorithm SHA256).Hash.ToLowerInvariant() -ne $repairDigest) { throw 'Repair patch hash mismatch. Use exact LF bytes.' }
+if ((Get-FileHash -LiteralPath $proofPatch -Algorithm SHA256).Hash.ToLowerInvariant() -ne $proofDigest) { throw 'Native proof patch hash mismatch. Use exact LF bytes.' }
+if ($AttendedSyntheticProof -and (-not [Environment]::UserInteractive -or -not (Test-Path -LiteralPath $Node -PathType Leaf))) { throw 'An attended desktop and explicit node.exe path are required for native execution.' }
+foreach ($name in $helperDigests.Keys) {
+    $path = Join-Path $HelperSource $name
+    if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $helperDigests[$name]) { throw "Helper source hash mismatch: $name. Use exact LF bytes." }
+}
+$stage = Join-Path ([IO.Path]::GetTempPath()) ('AgrippaNativeProof-' + [Guid]::NewGuid().ToString('N'))
+$source = Join-Path $stage 'source'
+$logs = Join-Path $stage 'logs'
+$evidence = Join-Path $stage 'evidence'
+$helper = Join-Path $stage 'helper'
+$data = Join-Path $stage 'empty-tray-data'
+foreach ($directory in @($stage, $logs, $evidence, $helper, $data)) { [void](New-Item -ItemType Directory -Path $directory) }
+Write-Host "Isolated staging and retained evidence: $stage"
+function Invoke-Checked([string]$File, [string[]]$Arguments, [string]$LogName) {
+    & $File @Arguments 2>&1 | Tee-Object -FilePath (Join-Path $logs $LogName) | Out-Host
+    if ($LASTEXITCODE -ne 0) { throw "$File failed with exit code $LASTEXITCODE; see $LogName" }
+}
+$names = @('PATH','DOTNET_ROOT','OPENCLAW_REPO_ROOT','OPENCLAW_TRAY_DATA_DIR','AGRIPPA_NATIVE_APPROVAL_PROOF','AGRIPPA_PROOF_NODE_EXE','AGRIPPA_PROOF_HELPER_MJS','AGRIPPA_NATIVE_PROOF_DIR','DOTNET_CLI_TELEMETRY_OPTOUT')
+$saved = @{}
+foreach ($name in $names) { $saved[$name] = [Environment]::GetEnvironmentVariable($name, 'Process') }
+$locationPushed = $false
+try {
+    $env:DOTNET_ROOT = Split-Path -Parent ([IO.Path]::GetFullPath($Dotnet))
+    $env:PATH = $env:DOTNET_ROOT + [IO.Path]::PathSeparator + $env:PATH
+    $env:DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+    $env:OPENCLAW_REPO_ROOT = $source
+    $env:OPENCLAW_TRAY_DATA_DIR = $data
+    $env:AGRIPPA_NATIVE_APPROVAL_PROOF = $null
+    Invoke-Checked $Dotnet @('--list-sdks') 'sdk.log'
+    if (-not (Select-String -LiteralPath (Join-Path $logs 'sdk.log') -Pattern '^10\.0\.400 ' -Quiet)) { throw 'Existing .NET SDK 10.0.400 is required. This launcher does not install it.' }
+    Invoke-Checked 'git' @('clone','--no-hardlinks','--no-checkout','--',$SourceRepository,$source) 'clone.log'
+    Invoke-Checked 'git' @('-C',$source,'checkout','--detach',$baseCommit) 'checkout.log'
+    Invoke-Checked 'git' @('-C',$source,'apply','--check',[IO.Path]::GetFullPath($RepairPatch)) 'repair-check.log'
+    Invoke-Checked 'git' @('-C',$source,'apply',[IO.Path]::GetFullPath($RepairPatch)) 'repair-apply.log'
+    Invoke-Checked 'git' @('-C',$source,'apply','--check',$proofPatch) 'proof-check.log'
+    Invoke-Checked 'git' @('-C',$source,'apply',$proofPatch) 'proof-apply.log'
+    Invoke-Checked 'git' @('-C',$source,'diff','--check') 'diff-check.log'
+    foreach ($file in @('ApprovalNotice.cs','approval-notice.mjs','protocol.mjs','receipt.mjs','render-proof.mjs')) {
+        Copy-Item -LiteralPath (Join-Path $HelperSource $file) -Destination (Join-Path $helper $file)
+    }
+    $csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'
+    Invoke-Checked $csc @('/nologo','/target:winexe','/reference:System.Windows.Forms.dll','/reference:System.Drawing.dll',('/out:' + (Join-Path $helper 'ApprovalNotice.exe')),(Join-Path $helper 'ApprovalNotice.cs')) 'helper-build.log'
+    Push-Location -LiteralPath $source
+    $locationPushed = $true
+    $project = 'tests/OpenClaw.Tray.UITests/OpenClaw.Tray.UITests.csproj'
+    Invoke-Checked $Dotnet @('restore',$project,'-r','win-x64') 'ui-restore.log'
+    Invoke-Checked $Dotnet @('build',$project,'-c','Debug','-r','win-x64','--no-restore') 'ui-build.log'
+    $assembly = Join-Path $source 'tests/OpenClaw.Tray.UITests/bin/Debug/net10.0-windows10.0.22621.0/win-x64/OpenClaw.Tray.UITests.dll'
+    if (-not (Test-Path -LiteralPath $assembly -PathType Leaf)) { throw 'Expected compiled UI test assembly missing.' }
+    $files = @($RepairPatch,$proofPatch,$Dotnet,$assembly) + @(Get-ChildItem -LiteralPath $helper -File | ForEach-Object FullName)
+    @($files | ForEach-Object { Get-FileHash -LiteralPath $_ -Algorithm SHA256 } | Select-Object Path,Hash) | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $evidence 'input-hashes.json')
+    if (-not $AttendedSyntheticProof) {
+        Write-Host 'COMPILE ONLY finished. No UI, real approval, install, runtime installation, or production settings access was requested.'
+        Write-Host 'This targeted compilation is not the required full build/Shared/Tray validation or native proof.'
+    } else {
+        $env:AGRIPPA_NATIVE_APPROVAL_PROOF = 'I_AM_RUNNING_ISOLATED_PROOF'
+        $env:AGRIPPA_PROOF_NODE_EXE = [IO.Path]::GetFullPath($Node)
+        $env:AGRIPPA_PROOF_HELPER_MJS = Join-Path $helper 'approval-notice.mjs'
+        $env:AGRIPPA_NATIVE_PROOF_DIR = $evidence
+        Write-Host 'Starting synthetic visible proof. Keep this console foreground and do not click any approval. No production node or tray app is started.'
+        Invoke-Checked $Dotnet @('test',$project,'-c','Debug','-r','win-x64','--no-build','--no-restore','--filter','FullyQualifiedName~ApprovalNoticeNativeProofTests','--results-directory',$evidence,'--logger','trx;LogFileName=approval-native.trx') 'native-test.log'
+        [xml]$trx = Get-Content -LiteralPath (Join-Path $evidence 'approval-native.trx') -Raw
+        $manager = [Xml.XmlNamespaceManager]::new($trx.NameTable)
+        $manager.AddNamespace('t','http://microsoft.com/schemas/VisualStudio/TeamTest/2010')
+        $counters = $trx.SelectSingleNode('//t:ResultSummary/t:Counters',$manager)
+        if ($null -eq $counters -or $counters.total -ne '2' -or $counters.executed -ne '2' -or $counters.passed -ne '2') { throw 'Native proof did not execute and pass both scenarios. A skip/no-op is not success.' }
+        Write-Host 'Both synthetic scenarios passed. Screen images still require human inspection; installed behavior remains unproved.'
+    }
+} finally {
+    if ($locationPushed) { Pop-Location }
+    foreach ($name in $names) { [Environment]::SetEnvironmentVariable($name,$saved[$name],'Process') }
+    @(Get-ChildItem -LiteralPath $evidence -Recurse -File | ForEach-Object { Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256 } | Select-Object Path,Hash) | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $stage 'evidence-hashes.json')
+    Write-Host "Retained staging: $stage"
+}
diff --git a/tests/NativeApprovalProof/approval-notice.mjs b/tests/NativeApprovalProof/approval-notice.mjs
new file mode 100644
index 0000000..ca45df5
--- /dev/null
+++ b/tests/NativeApprovalProof/approval-notice.mjs
@@ -0,0 +1,42 @@
+import {spawn} from 'node:child_process';
+import {createInterface} from 'node:readline';
+import {randomUUID} from 'node:crypto';
+import {mkdir} from 'node:fs/promises';
+import {fileURLToPath} from 'node:url';
+import path from 'node:path';
+import {performance} from 'node:perf_hooks';
+import {NoticeProtocol} from './protocol.mjs';
+import {persistReceiptThenAcknowledge} from './receipt.mjs';
+const root=path.dirname(fileURLToPath(import.meta.url));
+const nonce=randomUUID(),state=new NoticeProtocol(nonce,performance.now());
+const receiptDir=path.join(root,'receipts');await mkdir(receiptDir,{recursive:true});
+const events=[];let child,interval,releaseDeadline=null,lossDeadline=null,done=false,exited=false;
+const event=(name)=>events.push({name,at:new Date().toISOString()});
+const host=createInterface({input:process.stdin,crlfDelay:Infinity});
+function send(line){if(child&&!child.stdin.destroyed)child.stdin.write(line+'\n');}
+function lost(reason){if(state.lost&&lossDeadline!==null)return;state.lost=true;event(reason);process.stdout.write('LOST\n');lossDeadline=performance.now()+15000;}
+async function finish(ok,reason){if(done)return;done=true;clearInterval(interval);event(reason);host.close();process.stdin.pause();
+ try {await persistReceiptThenAcknowledge({dir:receiptDir,nonce,outcome:ok?'released':'unknown',events,
+  acknowledge:line=>new Promise((resolve,reject)=>process.stdout.write(line+'\n',error=>error?reject(error):resolve()))});}
+ catch {ok=false;lost('receipt_unavailable');}
+ // Never kill an unconfirmed visible notice: its UI independently becomes amber.
+ if(!ok&&child&&!exited)child.unref();process.exit(ok?0:2);
+}
+host.on('line',line=>{if(line!=='RELEASE'){lost('invalid_host_protocol');return;}
+ if(!state.releasing){event('release_requested');send(state.release());releaseDeadline=performance.now()+3000;}});
+host.on('close',()=>{if(!done){lost('host_eof_without_confirmed_closure');}});
+child=spawn(path.join(root,'ApprovalNotice.exe'),[nonce],{windowsHide:true,stdio:['pipe','pipe','pipe']});
+child.on('error',()=>{lost('ui_launch_failed');finish(false,'ui_unavailable');});
+child.stdin.on('error',()=>lost('ui_pipe_failed'));
+createInterface({input:child.stdout,crlfDelay:Infinity}).on('line',line=>{try{
+ const message=state.accept(line,performance.now());if(message==='RELEASED'){event('hidden_confirmed');void finish(true,'confirmed_hidden');}
+ else if(message){event(message.toLowerCase());process.stdout.write(message+'\n');}
+}catch{lost('invalid_ui_protocol');}});
+// Drain stderr, but never copy unbounded native output to the host transcript.
+child.stderr.on('data',()=>{});
+child.on('exit',()=>{exited=true;if(!state.released)lost('ui_exit_without_hidden');});
+interval=setInterval(()=>{const now=performance.now();try{state.health(now);}catch{lost('stale_ui_ack');}
+ if((releaseDeadline!==null&&now>releaseDeadline)||(lossDeadline!==null&&now>lossDeadline)){finish(false,'closure_unconfirmed');return;}
+ if(!state.releasing&&!state.lost)send(state.ping());
+},200);
+event('started');
