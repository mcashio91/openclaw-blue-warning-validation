index 0000000..13f2f88
--- /dev/null
+++ b/tests/NativeApprovalProof/protocol.mjs
@@ -0,0 +1,16 @@
+// Deterministic protocol core. No desktop reservation is read or written.
+export class NoticeProtocol {
+ constructor(nonce, now) { this.nonce=nonce;this.started=now;this.last=null;this.sent=0;this.acked=0;this.ready=false;this.releasing=false;this.released=false;this.lost=false; }
+ ping(){return `PING ${this.nonce} ${++this.sent}`;}
+ accept(line,now){
+  const p=line.split(' ');
+  if(p.length===2&&p[0]==='HIDDEN'&&p[1]===this.nonce&&this.releasing){this.released=true;return 'RELEASED';}
+  if(p.length!==4||p[0]!=='ACK'||p[1]!==this.nonce||!/^\d+$/.test(p[2])||!/^\d+$/.test(p[3]))throw Error('Invalid UI protocol');
+  const seq=Number(p[2]),elapsed=Number(p[3]);
+  if(!Number.isSafeInteger(seq)||(seq>this.sent||seq<=this.acked)||!Number.isSafeInteger(elapsed)||elapsed<0)throw Error('Invalid UI acknowledgement');
+  this.last=now;this.acked=seq;
+  if(!this.ready&&!this.releasing&&!this.lost&&elapsed>=1500&&now-this.started>=1500){this.ready=true;return 'READY';}
+ }
+ release(){this.releasing=true;return `RELEASE ${this.nonce}`;}
+ health(now){if(this.released)return; if((this.last===null&&now-this.started>8000)||(this.last!==null&&now-this.last>1500)){this.lost=true;throw Error('UI acknowledgement expired');}}
+}
diff --git a/tests/NativeApprovalProof/receipt.mjs b/tests/NativeApprovalProof/receipt.mjs
new file mode 100644
index 0000000..aec2de9
--- /dev/null
+++ b/tests/NativeApprovalProof/receipt.mjs
@@ -0,0 +1,21 @@
+import {writeFile, rename, readFile} from 'node:fs/promises';
+import path from 'node:path';
+
+// A RELEASED acknowledgement is a commit: its exact receipt bytes must be
+// flushed, atomically published and read back first. Unknown is never released.
+export async function persistReceiptThenAcknowledge({dir, nonce, outcome, events, acknowledge,
+  storage = {writeFile, rename, readFile}}) {
+ if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(nonce))
+  throw new Error('Invalid receipt nonce');
+ if (outcome !== 'released' && outcome !== 'unknown')
+  throw new Error('Invalid receipt outcome');
+ const target = path.join(dir, nonce + '.json');
+ const staging = target + '.staging';
+ const bytes = JSON.stringify({schema:1,nonce,outcome,events}) + '\n';
+ await storage.writeFile(staging, bytes, {flag:'wx', flush:true});
+ await storage.rename(staging, target);
+ const observed = await storage.readFile(target, 'utf8');
+ if (observed !== bytes) throw new Error('Receipt readback mismatch');
+ if (outcome === 'released') await acknowledge('RELEASED');
+ return target;
+}
